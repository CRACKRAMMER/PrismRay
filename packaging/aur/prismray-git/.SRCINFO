pkgbase = prismray-git
	pkgdesc = Dual-core desktop proxy client (sing-box + Xray) with TUN, Clash API and subscriptions
	pkgver = 1.0.0.r0.g0000000
	pkgrel = 1
	url = https://github.com/CRACKRAMMER/PrismRay
	arch = x86_64
	arch = aarch64
	license = MPL-2.0
	makedepends = git
	makedepends = go>=1.26.0
	makedepends = rust
	makedepends = nodejs>=22
	makedepends = npm
	makedepends = python
	makedepends = pkgconf
	depends = webkit2gtk-4.1
	depends = gtk3
	depends = libayatana-appindicator
	depends = openssl
	depends = librsvg
	depends = hicolor-icon-theme
	optdepends = sing-box: primary proxy & TUN core (auto-downloaded if omitted)
	optdepends = xray: on-demand XHTTP / VLESS encryption coprocessor (auto-downloaded if omitted)
	optdepends = fprintd: optional fingerprint unlock
	optdepends = polkit: system authentication fallback for biometric unlock and privileged TUN
	provides = prismray=1.0.0.r0.g0000000
	conflicts = prismray
	conflicts = prismray-bin
	options = !lto
	options = !debug
	source = prismray::git+https://github.com/CRACKRAMMER/PrismRay.git
	sha256sums = SKIP

pkgname = prismray-git
