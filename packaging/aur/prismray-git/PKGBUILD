# SPDX-License-Identifier: MPL-2.0
pkgname=prismray-git
pkgver=1.0.0.r0.g0000000
pkgrel=1
pkgdesc='Dual-core desktop proxy client (sing-box + Xray) with TUN, Clash API and subscriptions'
arch=('x86_64' 'aarch64')
url='https://github.com/CRACKRAMMER/PrismRay'
license=('MPL-2.0')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'openssl' 'librsvg' 'hicolor-icon-theme')
makedepends=('git' 'go>=1.26.3' 'rust' 'nodejs>=22' 'npm' 'python' 'pkgconf')
optdepends=(
  'xray: on-demand XHTTP / VLESS encryption coprocessor (auto-downloaded if omitted)'
  'fprintd: optional fingerprint unlock'
  'polkit: system authentication fallback for biometric unlock and privileged TUN'
)
provides=("prismray=${pkgver}")
conflicts=('prismray' 'prismray-bin')
options=('!lto' '!debug')
source=('prismray::git+https://github.com/CRACKRAMMER/PrismRay.git')
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/prismray"
  local version
  version=$(python -c 'import json; print(json.load(open("frontend/package.json"))["version"])')
  printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$srcdir/prismray/frontend"
  npm ci --no-audit --no-fund
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')" --manifest-path src-tauri/Cargo.toml
  cd ../backend
  go mod download
  cd singbox-android
  go mod download
}

build() {
  cd "$srcdir/prismray"
  export RUST_TARGET="$(rustc -vV | sed -n 's/^host: //p')"
  export CARGO_TARGET_DIR="$srcdir/target"
  export CGO_ENABLED=0
  python scripts/build_sidecar.py
  (
    cd backend/singbox-android
    go build -trimpath \
      -tags "with_gvisor,with_quic,with_wireguard,with_utls,with_clash_api,with_tailscale" \
      -ldflags='-s -w' \
      -o "$srcdir/sing-box" .
  )
  cd frontend
  npm run tauri -- build --ci --ignore-version-mismatches --no-bundle --target "$RUST_TARGET" -- --locked --offline
}

check() {
  cd "$srcdir/prismray/backend"
  go test ./...
  cd singbox-android
  go test -tags "with_gvisor,with_quic,with_wireguard,with_utls,with_clash_api,with_tailscale" ./...
}

package() {
  cd "$srcdir/prismray"
  local target
  target="$(rustc -vV | sed -n 's/^host: //p')"
  install -Dm755 "$srcdir/target/$target/release/prismray" "$pkgdir/usr/lib/prismray/prismray"
  install -Dm755 "frontend/src-tauri/binaries/prismray-server-$target" "$pkgdir/usr/lib/prismray/prismray-server"
  install -Dm755 "$srcdir/sing-box" "$pkgdir/usr/lib/prismray/sing-box"
  install -d "$pkgdir/usr/bin"
  ln -s /usr/lib/prismray/prismray "$pkgdir/usr/bin/prismray"
  install -Dm644 packaging/prismray.desktop "$pkgdir/usr/share/applications/prismray.desktop"
  ln -s prismray.desktop "$pkgdir/usr/share/applications/com.crackrammer.prismray.desktop"
  install -Dm644 frontend/src-tauri/icons/prismray-icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/prismray.svg"
  install -Dm644 frontend/src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/prismray.png"
  install -Dm644 frontend/src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/prismray.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
  install -Dm644 docs/SUBSCRIPTIONS.md "$pkgdir/usr/share/doc/$pkgname/SUBSCRIPTIONS.md"
}
